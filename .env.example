# Public site URL used for canonical URLs, schema and social metadata
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Tanvi Blog Manager authentication
BLOG_ADMIN_PASSWORD=choose-a-strong-clinic-editor-password
BLOG_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Fine-grained GitHub token: repository Contents = Read and write only
GITHUB_CONTENT_TOKEN=github_pat_replace_me
GITHUB_CONTENT_REPOSITORY=Mr-Nani-dm/Tanvi-Dental-Care
# Local development must use a separate branch. Vercel previews automatically
# use VERCEL_GIT_COMMIT_REF, even if an inherited setting says main.
GITHUB_CONTENT_BRANCH=feature/tanvi-content-os-v1

# Content OS: SERVER ONLY. Configure for Preview first, never NEXT_PUBLIC_*.
# Choose models available to the clinic's OpenAI project and confirm billing.
OPENAI_API_KEY=
CONTENT_OS_TEXT_MODEL=
CONTENT_OS_REVIEW_MODEL=
CONTENT_OS_IMAGE_MODEL=
